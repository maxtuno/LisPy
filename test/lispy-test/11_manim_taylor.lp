;;; ============================================================
;;; LisPy Advanced 11 — Manim: Taylor Series Animation
;;; Pure py: API — py:run drives manim scene rendering
;;; ============================================================

(format t "~%=== LisPy + Manim: Taylor Series of sin(x) ===~%~%")

(format t "Rendering Taylor series (d=1,3,5,7,9,11,13)...~%")

(let ((script (format nil "~{~A~^~%~}"
                     `("import sys"
                       "sys.path.insert(0, 'C:/Users/river/Documents/R/Development/LisPy/advanced/venv/Lib/site-packages')"
                       ""
                       "from manim import *"
                       "import numpy as np, math, shutil, os"
                       ""
                       "config.quality = 'medium_quality'"
                       "config.frame_rate = 30"
                       "config.pixel_height = 720"
                       "config.pixel_width = 1280"
                       "config.media_dir = 'advanced/_manim_media'"
                       ""
                       "def taylor_sin(x, n):"
                       "    s = np.zeros_like(x)"
                       "    for k in range(n + 1):"
                       "        term = 2 * k + 1"
                       "        sign = (-1) ** k"
                       "        s += sign * x ** term / math.factorial(term)"
                       "    return s"
                       ""
                       "class TaylorSin(Scene):"
                       "    def construct(self):"
                       "        axes = Axes("
                       "            x_range=[-8, 8, 2],"
                       "            y_range=[-2, 2, 0.5],"
                       "            x_length=10,"
                       "            y_length=4,"
                       "            axis_config={'include_tip': False, 'font_size': 24},"
                       "        )"
                       "        labels = axes.get_axis_labels("
                       "            MathTex('x').scale(0.9),"
                       "            MathTex('y').scale(0.9),"
                       "        )"
                       "        self.play(Create(axes), Write(labels))"
                       ""
                       "        sin_graph = axes.plot(np.sin, color=BLUE, stroke_width=2)"
                       "        sin_label = MathTex(r'\\sin(x)', color=BLUE).to_corner(UR).shift(DOWN * 0.5)"
                       "        self.play(Create(sin_graph), Write(sin_label))"
                       "        self.wait(0.5)"
                       ""
                       "        degrees = [1, 3, 5, 7, 9, 11, 13]"
                       "        colors = color_gradient([YELLOW, RED], len(degrees))"
                       "        prev_graph = None"
                       "        prev_label = None"
                       ""
                       "        for i, d in enumerate(degrees):"
                       "            taylor_graph = axes.plot("
                       "                lambda x, d=d: taylor_sin(x, (d - 1) // 2),"
                       "                color=colors[i],"
                       "                stroke_width=1.5,"
                       "            )"
                       "            degree_label = MathTex("
                       "                f'n={d}', color=colors[i], font_size=28"
                       "            ).next_to(sin_label, DOWN, buff=0.3)"
                       ""
                       "            if prev_graph is None:"
                       "                self.play(Create(taylor_graph), Write(degree_label), run_time=1.5)"
                       "            else:"
                       "                self.play("
                       "                    Transform(prev_graph, taylor_graph),"
                       "                    Transform(prev_label, degree_label),"
                       "                    run_time=1,"
                       "                )"
                       "            prev_graph = taylor_graph"
                       "            prev_label = degree_label"
                       "            self.wait(0.3)"
                       ""
                       "        self.wait(2)"
                       ""
                       "scene = TaylorSin()"
                       "scene.render()"
                       ""
                       "# Copy to final output"
                       "src = os.path.join(config.media_dir, 'videos', '720p30', 'TaylorSin.mp4')"
                       "if os.path.exists(src):"
                       "    shutil.copy2(src, 'advanced/out_11_taylor_sine.mp4')"
                       "    sys.stdout.write('OUTPUT_READY\\n')"
                       "    sys.stdout.flush()"))))

  (py:run script)
  (format t "Saved advanced/out_11_taylor_sine.mp4~%"))

(format t "~%=== Manim Demo Complete ===~%~%"))
