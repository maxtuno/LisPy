(defun longest-palindrome (s)
  (let ((n (length s))
        (start 0)
        (max-len 1))
    (dotimes (i n)
      (let ((left i) (right i))
        (loop while (and (>= left 0) (< right n)
                         (char= (char s left) (char s right)))
              do (decf left) (incf right))
        (let ((len (- right left 1)))
          (when (> len max-len)
            (setf start (1+ left) max-len len))))
      (let ((left i) (right (1+ i)))
        (loop while (and (>= left 0) (< right n)
                         (char= (char s left) (char s right)))
              do (decf left) (incf right))
        (let ((len (- right left 1)))
          (when (> len max-len)
            (setf start (1+ left) max-len len)))))
    (subseq s start (+ start max-len))))

(format t "Longest Palindromic Substring:~%")
(format t "  \"babad\" => ~S~%" (longest-palindrome "babad"))
(format t "  \"cbbd\" => ~S~%" (longest-palindrome "cbbd"))
