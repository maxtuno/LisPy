(defun reverse-integer (x)
  (let* ((neg (< x 0))
         (py-x (py:->python (if neg (- x) x)))
         (s (py:str py-x))
         (py-join (py:attr (py:->python "") "join"))
         (rev-str (py:call py-join (py:reversed s)))
         (rev-num (py:int rev-str))
         (result (if neg (- rev-num) rev-num))
         (max-int 2147483647)
         (min-int -2147483648))
    (if (or (> result max-int) (< result min-int))
        0
        result)))

(format t "Reverse Integer:~%")
(format t "  123 => ~A~%" (reverse-integer 123))
(format t "  -123 => ~A~%" (reverse-integer -123))
(format t "  120 => ~A~%" (reverse-integer 120))
(format t "  0 => ~A~%" (reverse-integer 0))
