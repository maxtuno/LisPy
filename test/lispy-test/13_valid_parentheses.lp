(defun valid-parentheses (s)
  (progn)
  (let* ((pairs (make-hash-table :test 'equal))
         (stack nil)
         (len (length s)))
    (setf (gethash ")" pairs) "(")
    (setf (gethash "}" pairs) "{")
    (setf (gethash "]" pairs) "[")
    (block check
      (dotimes (i len)
        (let ((ch (char s i)))
          (if (or (char= ch #\() (char= ch #\{) (char= ch #\[))
              (push ch stack)
              (progn
                (when (null stack)
                  (return-from check nil))
                (let ((top (pop stack)))
                  (when (not (char= top (char (gethash (string ch) pairs) 0)))
                    (return-from check nil)))))))
      (null stack))))

(format t "Valid Parentheses:~%")
(format t "  () => ~A~%" (valid-parentheses "()"))
(format t "  ()[]{} => ~A~%" (valid-parentheses "()[]{}"))
(format t "  (] => ~A~%" (valid-parentheses "(]"))
(format t "  ([)] => ~A~%" (valid-parentheses "([)]"))
