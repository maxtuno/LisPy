(defun make-min-stack ()
  (list nil nil))

(defun stack-push (ms val)
  (let ((stack (nth 0 ms))
        (min-stack (nth 1 ms)))
    (setf (nth 0 ms) (cons val stack))
    (setf (nth 1 ms)
          (if (or (null min-stack) (<= val (car min-stack)))
              (cons val min-stack)
              min-stack))
    ms))

(defun stack-pop (ms)
  (let ((stack (nth 0 ms))
        (min-stack (nth 1 ms)))
    (when stack
      (let ((popped (car stack)))
        (setf (nth 0 ms) (cdr stack))
        (when (= popped (car min-stack))
          (setf (nth 1 ms) (cdr min-stack)))))
    ms))

(defun stack-top (ms)
  (let ((stack (nth 0 ms)))
    (if stack (car stack) nil)))

(defun stack-get-min (ms)
  (let ((min-stack (nth 1 ms)))
    (if min-stack (car min-stack) nil)))

(format t "Min Stack:~%")
(let ((ms (make-min-stack)))
  (stack-push ms -2)
  (stack-push ms 0)
  (stack-push ms -3)
  (format t "  push -2, 0, -3~%")
  (format t "  getMin => ~A~%" (stack-get-min ms))
  (stack-pop ms)
  (format t "  pop~%")
  (format t "  top => ~A~%" (stack-top ms))
  (format t "  getMin => ~A~%" (stack-get-min ms)))
