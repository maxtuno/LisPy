(defun roman-to-int (s)
  (let ((vals (make-hash-table :test 'equal))
        (result 0)
        (prev 0))
    (setf (gethash "I" vals) 1)
    (setf (gethash "V" vals) 5)
    (setf (gethash "X" vals) 10)
    (setf (gethash "L" vals) 50)
    (setf (gethash "C" vals) 100)
    (setf (gethash "D" vals) 500)
    (setf (gethash "M" vals) 1000)
    (dotimes (i (length s))
      (let* ((ch (string (char s i)))
             (cur (gethash ch vals)))
        (if (> cur prev)
            (setf result (- (+ result cur) (* 2 prev)))
            (setf result (+ result cur)))
        (setf prev cur)))
    result))

(format t "Roman to Integer:~%")
(format t "  III => ~A~%" (roman-to-int "III"))
(format t "  IV => ~A~%" (roman-to-int "IV"))
(format t "  LVIII => ~A~%" (roman-to-int "LVIII"))
(format t "  MCMXCIV => ~A~%" (roman-to-int "MCMXCIV"))
