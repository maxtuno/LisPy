;;; ============================================================
;;; LisPy Advanced 00 — SymPy: Symbolic Calculus
;;; Pure py: API — differentiation, integration, limits, series, ODEs
;;; ============================================================

(format t "~%=== LisPy + SymPy: Symbolic Calculus ===~%~%")

(let ((sp (py:import "sympy")))

  (format t "[1] Symbolic Differentiation~%")
  (let* ((sym (py:attr sp "Symbol"))
         (x   (py:call sym "x"))
         (sin (py:attr sp "sin"))
         (diff (py:attr sp "diff"))
         (integrate (py:attr sp "integrate"))
         (expr (py:call sin x))
         (d (py:call diff expr x))
         (i (py:call integrate d x)))
    (format t "  d/dx sin(x) = ~A~%" (py:str d))
    (format t "  int cos(x) dx = ~A~%~%" (py:str i)))

  (format t "[2] Polynomial Expansion & Factorization~%")
  (let* ((sym (py:attr sp "Symbol"))
         (x   (py:call sym "x"))
         (expand (py:attr sp "expand"))
         (factor (py:attr sp "factor"))
         (Add (py:attr sp "Add"))
         (Pow (py:attr sp "Pow"))
         (Mul (py:attr sp "Mul"))
         (poly (py:call expand (py:call Pow (py:call Add x 1) 5)))
         (expr (py:call Add (py:call Pow x 4) (py:call Mul -4 (py:call Pow x 2)) 4))
         (fact (py:call factor expr)))
    (format t "  (x+1)^5  = ~A~%" (py:str poly))
    (format t "  x^4-4x^2+4 = ~A~%~%" (py:str fact)))

  (format t "[3] Limits~%")
  (let* ((sym (py:attr sp "Symbol"))
         (x   (py:call sym "x"))
         (oo  (py:attr sp "oo"))
         (limit (py:attr sp "limit"))
         (Mul (py:attr sp "Mul"))
         (Pow (py:attr sp "Pow"))
         (Add (py:attr sp "Add"))
         (sin (py:attr sp "sin"))
         (lim-e    (py:call limit (py:call Mul (py:call Pow (py:call Add 1 (py:call Pow x -1)) x)) x oo))
         (lim-sinc (py:call limit (py:call Mul (py:call sin x) (py:call Pow x -1)) x 0)))
    (format t "  lim (1+1/x)^x  = ~A~%" (py:str lim-e))
    (format t "  lim sin(x)/x  = ~A~%~%" (py:str lim-sinc)))

  (format t "[4] Series Expansion~%")
  (let* ((sym (py:attr sp "Symbol"))
         (x   (py:call sym "x"))
         (series (py:attr sp "series"))
         (sin (py:attr sp "sin"))
         (s (py:call series (py:call sin x) x 0 10)))
    (format t "  sin(x) = ~A~%~%" (py:str s)))

  (format t "[5] Equation Solving~%")
  (let* ((sym (py:attr sp "Symbol"))
         (x   (py:call sym "x"))
         (Eq (py:attr sp "Eq"))
         (Add (py:attr sp "Add"))
         (Pow (py:attr sp "Pow"))
         (Mul (py:attr sp "Mul"))
         (solve (py:attr sp "solve"))
         (eq (py:call Eq (py:call Add (py:call Pow x 2) (py:call Mul -5 x) 6) 0))
         (solns (py:call solve eq x)))
     (format t "  x^2 - 5x + 6 = 0  =>  ~A~%~%" (py:str (py:->python solns))))

  (format t "[6] Differential Equations~%")
  (let* ((sym (py:attr sp "Symbol"))
         (func (py:attr sp "Function"))
         (x   (py:call sym "x"))
         (f   (py:call func "f"))
         (Derivative (py:attr sp "Derivative"))
         (Eq (py:attr sp "Eq"))
         (Mul (py:attr sp "Mul"))
         (dsolve (py:attr sp "dsolve"))
         (deriv (py:call Derivative (py:call f x) x))
         (eq (py:call Eq deriv (py:call Mul -2 (py:call f x))))
         (sol (py:call dsolve eq (py:call f x))))
    (format t "  f'(x) = -2*f(x)  =>  ~A~%~%" (py:str sol)))

  (format t "=== SymPy Calculus Complete ===~%~%"))
