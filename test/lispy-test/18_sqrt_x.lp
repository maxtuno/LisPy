(defun int-sqrt (x)
  (when (= x 0) (return-from int-sqrt 0))
  (let ((left 1) (right x) (ans 0))
    (loop while (<= left right)
          do (let ((mid (floor (+ left right) 2)))
               (if (<= (* mid mid) x)
                   (setf ans mid left (1+ mid))
                   (setf right (1- mid)))))
    ans))

(format t "Sqrt(x):~%")
(format t "  4 => ~A~%" (int-sqrt 4))
(format t "  8 => ~A~%" (int-sqrt 8))
(format t "  0 => ~A~%" (int-sqrt 0))
