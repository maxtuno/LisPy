(defun happy-number (n)
  (let ((seen (make-hash-table :test 'eql)))
    (loop for i from 1 to 1000
          do (when (= n 1) (return-from happy-number t))
          do (when (gethash n seen) (return-from happy-number nil))
          do (setf (gethash n seen) t)
          do (let* ((sum-sq 0)
                    (tmp n))
               (loop while (> tmp 0)
                     do (let ((d (rem tmp 10)))
                          (setf sum-sq (+ sum-sq (* d d))
                                tmp (floor tmp 10))))
               (setf n sum-sq)))
    nil))

(format t "Happy Number:~%")
(format t "  19 => ~A~%" (happy-number 19))
(format t "  2 => ~A~%" (happy-number 2))
(format t "  7 => ~A~%" (happy-number 7))
