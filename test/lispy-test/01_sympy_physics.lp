;;; ============================================================
;;; LisPy Advanced 01 — SymPy: Symbolic Physics
;;; Pure py: API — kinematics, projectiles, oscillators
;;; ============================================================

(format t "~%=== LisPy + SymPy: Physics Simulations ===~%~%")

(let ((sp (py:import "sympy")))

  (format t "[1] 1D Kinematics (Constant Acceleration)~%")
  (let* ((sym (py:attr sp "Symbol"))
         (tm  (py:call sym "t"))
         (v0  (py:call sym "v0"))
         (ac  (py:call sym "a"))
         (x0  (py:call sym "x0"))
         (integrate (py:attr sp "integrate"))
         (Add (py:attr sp "Add"))
         (vel (py:call Add v0 (py:call integrate ac tm)))
         (pos (py:call Add x0 (py:call integrate vel tm))))
    (format t "  v(t) = ~A~%" (py:str vel))
    (format t "  x(t) = ~A~%~%" (py:str pos)))

  (format t "[2] Projectile Motion~%")
  (let* ((sym (py:attr sp "Symbol"))
         (tm    (py:call sym "t"))
         (grav  (py:call sym "g"))
         (v0    (py:call sym "v0"))
         (theta (py:call sym "theta"))
         (sin (py:attr sp "sin"))
         (cos (py:attr sp "cos"))
         (Mul (py:attr sp "Mul"))
         (Add (py:attr sp "Add"))
         (integrate (py:attr sp "integrate"))
         (v0x (py:call Mul v0 (py:call cos theta)))
         (v0y (py:call Mul v0 (py:call sin theta)))
         (vy  (py:call Add v0y (py:call integrate (py:call Mul -1 grav) tm)))
         (x-pos (py:call integrate v0x tm))
         (y-pos (py:call integrate vy tm)))
    (format t "  vx = ~A~%" (py:str v0x))
    (format t "  vy(t) = ~A~%" (py:str vy))
    (format t "  x(t)  = ~A~%" (py:str x-pos))
    (format t "  y(t)  = ~A~%~%" (py:str y-pos)))

  (format t "[3] Simple Harmonic Oscillator~%")
  (let* ((sym (py:attr sp "Symbol"))
         (func (py:attr sp "Function"))
         (tm  (py:call sym "t"))
         (ks  (py:call sym "k"))
         (ms  (py:call sym "m"))
         (xf  (py:call func "x"))
         (Mul (py:attr sp "Mul"))
         (Pow (py:attr sp "Pow"))
         (Add (py:attr sp "Add"))
         (sqrt (py:attr sp "sqrt"))
         (Derivative (py:attr sp "Derivative"))
         (Eq (py:attr sp "Eq"))
         (dsolve (py:attr sp "dsolve"))
         (omega (py:call sqrt (py:call Mul ks (py:call Pow ms -1))))
         (deriv2 (py:call Derivative (py:call xf tm) tm 2))
         (eq (py:call Eq (py:call Add deriv2 (py:call Mul (py:call Pow omega 2) (py:call xf tm))) 0))
         (sol (py:call dsolve eq (py:call xf tm))))
    (format t "  x'' + (k/m)*x = 0~%")
    (format t "  solution: ~A~%~%" (py:str sol)))

  (format t "[4] Damped Oscillator~%")
  (let* ((sym (py:attr sp "Symbol"))
         (func (py:attr sp "Function"))
         (tm  (py:call sym "t"))
         (bv  (py:call sym "b"))
         (ms  (py:call sym "m"))
         (ks  (py:call sym "k"))
         (xf  (py:call func "x"))
         (Mul (py:attr sp "Mul"))
         (Add (py:attr sp "Add"))
         (Derivative (py:attr sp "Derivative"))
         (Eq (py:attr sp "Eq"))
         (dsolve (py:attr sp "dsolve"))
         (d1 (py:call Derivative (py:call xf tm) tm))
         (d2 (py:call Derivative (py:call xf tm) tm 2))
         (eq (py:call Eq (py:call Add (py:call Mul ms d2) (py:call Mul bv d1) (py:call Mul ks (py:call xf tm))) 0))
         (sol (py:call dsolve eq (py:call xf tm))))
    (format t "  m*x'' + b*x' + k*x = 0~%")
    (format t "  solution: ~A~%~%" (py:str sol)))

  (format t "[5] Newton Cooling Law~%")
  (let* ((sym (py:attr sp "Symbol"))
         (func (py:attr sp "Function"))
         (tm  (py:call sym "t"))
         (rv  (py:call sym "r"))
         (Ta  (py:call sym "Ta"))
         (TF  (py:call func "T"))
         (Mul (py:attr sp "Mul"))
         (Add (py:attr sp "Add"))
         (Derivative (py:attr sp "Derivative"))
         (Eq (py:attr sp "Eq"))
         (dsolve (py:attr sp "dsolve"))
         (deriv (py:call Derivative (py:call TF tm) tm))
         (eq (py:call Eq deriv (py:call Mul -1 rv (py:call Add (py:call TF tm) (py:call Mul -1 Ta)))))
         (sol (py:call dsolve eq (py:call TF tm))))
    (format t "  dT/dt = -r*(T - Ta)~%")
    (format t "  solution: ~A~%~%" (py:str sol)))

  (format t "=== Physics Demo Complete ===~%~%"))
